packages: packages/*/**.cabal
tests: True
benchmarks: True

-- In order to support GHC 9.14, until new versions
-- of the following libraries, we must allow newer
-- versions of base
allow-newer:
  cborg:base,
  serialise:base

-- 2.1.3 is broken: https://github.com/kazu-yamamoto/crypton/issues/270
constraints: crypton <2.1.3

package distributed-process-tests
  flags: +tcp
